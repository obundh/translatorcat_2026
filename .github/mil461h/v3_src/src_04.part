        (r"수 없습니다\.", "수 없다."),
        (r"수 있습니다\.", "수 있다."),
        (r"하지 않습니다\.", "하지 않는다."),
        (r"않습니다\.", "않는다."),
        (r"합니다\.", "한다."),
        (r"됩니다\.", "된다."),
        (r"입니다\.", "이다."),
        (r"있습니다\.", "있다."),
        (r"없습니다\.", "없다."),
        (r"집니다\.", "진다."),
        (r"납니다\.", "난다."),
        (r"따릅니다\.", "따른다."),
        (r"갖습니다\.", "갖는다."),
        (r"해야 하며", "하여야 하며"),
        (r"해야 하고", "하여야 하고"),
    )
    for pat, repl in style:
        out = re.sub(pat, repl, out)
    if re.search(r"\bshall not\b", source, re.I):
        out = re.sub(r"(?:하면|해서는|하여서는) 안 (?:된다|됩니다)\.?", "하여서는 아니 된다.", out)
        out = re.sub(r"오작동해서는 안 된다", "오작동하여서는 아니 된다", out)
    elif re.search(r"\bshall\b", source, re.I):
        out = re.sub(r"해야 한다\.?$", "하여야 한다.", out)
    out = re.sub(r"\s+([,.;:!?%)\]])", r"\1", out)
    out = re.sub(r"([([])\s+", r"\1", out)
    out = re.sub(r"\s{2,}", " ", out).strip()
    return out



class GoogleTranslator:
    def __init__(self, cache_path: Path, workers: int = 8):
        self.cache_path = cache_path
        self.workers = workers
        self.lock = threading.Lock()
        self.cache: dict[str, str] = {}
        if cache_path.exists():
            try:
                self.cache = json.loads(cache_path.read_text(encoding="utf-8"))
            except Exception:
                self.cache = {}
        self.local = threading.local()

    def session(self) -> requests.Session:
        if not hasattr(self.local, "session"):
            s = requests.Session()
            s.headers.update({"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/151 Safari/537.36"})
            self.local.session = s
        return self.local.session

    def translate_one(self, source: str) -> str:
        exact = exact_lookup(source)
        if exact is not None:
            return exact
        if not should_translate(source):
            return source
        protected, mapping = protect(source)
        last_error = None
        for attempt in range(8):
            try:
                r = self.session().get(
                    "https://translate.googleapis.com/translate_a/single",
                    params={"client": "gtx", "sl": "en", "tl": "ko", "dt": "t", "q": protected},
                    timeout=45,
                )
                if r.status_code == 429:
                    raise RuntimeError("rate limited")
                r.raise_for_status()
                data = r.json()
                out = "".join(part[0] for part in data[0] if part and part[0])
                return formalize(source, restore(out, mapping))
            except Exception as exc:
                last_error = exc
                time.sleep(min(30, 1.2 * (2 ** attempt)))
        raise RuntimeError(f"Translation failed: {source[:120]!r}: {last_error}")

    def translate_all(self, texts: Iterable[str]) -> None:
        pending = []
        for text in texts:
            if text in self.cache:
                continue
            exact = exact_lookup(text)
            if exact is not None:
                self.cache[text] = exact
            elif not should_translate(text):
                self.cache[text] = text
            else:
                pending.append(text)
        self.flush()
        print(f"Google translation cache={len(self.cache)}, pending={len(pending)}", flush=True)
        if not pending:
            return
        completed = 0
        start = time.time()
        with concurrent.futures.ThreadPoolExecutor(max_workers=self.workers) as executor:
            futures = {executor.submit(self.translate_one, text): text for text in pending}
            for fut in concurrent.futures.as_completed(futures):
                source = futures[fut]
                try:
                    out = fut.result()
                except Exception:
                    # A sequential retry is usually enough after a burst rate limit.
                    out = self.translate_one(source)
                with self.lock:
                    self.cache[source] = out
                    completed += 1
                    if completed % 50 == 0 or completed == len(pending):
                        self.flush()
                        elapsed = max(1.0, time.time() - start)
                        print(f"Translated {completed}/{len(pending)} ({completed/elapsed:.2f}/s)", flush=True)

    def flush(self) -> None:
        tmp = self.cache_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.cache, ensure_ascii=False, indent=2), encoding="utf-8")
        tmp.replace(self.cache_path)

    def get(self, text: str) -> str:
        return self.cache.get(text, exact_lookup(text) or text)


def infer_rotation(line: dict) -> int:
    dx, dy = line.get("dir", (1.0, 0.0))
    angle = int(round(math.degrees(math.atan2(-dy, dx)))) % 360
    if angle <= 5 or angle >= 355:
        return 0
    if 85 <= angle <= 95:
        return 90
    if 175 <= angle <= 185:
        return 180
    if 265 <= angle <= 275:
        return 270
    return angle


def extract_lines(page: fitz.Page) -> list[Line]:
    result: list[Line] = []
    data = page.get_text("dict", flags=fitz.TEXTFLAGS_DICT)
    for bi, block in enumerate(data.get("blocks", [])):
        if block.get("type") != 0:
            continue
        for li, line in enumerate(block.get("lines", [])):
            spans = line.get("spans", [])
            if not spans:
                continue
            text = "".join(span.get("text", "") for span in spans)
            nonempty = [s for s in spans if s.get("text", "").strip()]
            sizes = [float(s.get("size", 9.0)) for s in nonempty] or [9.0]
            colors = [rgb(int(s.get("color", 0))) for s in nonempty] or [(0, 0, 0)]
            bold = any("bold" in s.get("font", "").lower() or (int(s.get("flags", 0)) & 16) for s in nonempty)
            italic = any("italic" in s.get("font", "").lower() or (int(s.get("flags", 0)) & 2) for s in nonempty)
            color = tuple(statistics.median(c[i] for c in colors) for i in range(3))
            result.append(Line(
                text=text,
                bbox=tuple(float(x) for x in line["bbox"]),
                font_size=statistics.median(sizes),
                bold=bold,
                italic=italic,
                color=color,
                rotation=infer_rotation(line),
                block_no=bi,
                line_no=li,
            ))
    return result


def is_header_footer(line: Line, page: fitz.Page) -> bool:
    t = norm(line.text)
    if not t:
        return True
