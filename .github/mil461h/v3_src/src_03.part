        (r"데크 아래", "갑판 아래"),
    )
    for pat, repl in replacements:
        out = re.sub(pat, repl, out)
    # Convert polite machine-translation endings throughout the paragraph.
    style = (
        (r"하여야 합니다\.", "하여야 한다."),
        (r"해야 합니다\.", "하여야 한다."),
        (r"되어야 합니다\.", "되어야 한다."),
        (r"해서는 안 됩니다\.", "하여서는 아니 된다."),
        (r"하지 않아야 합니다\.", "하여서는 아니 된다."),
        (r"할 수 없습니다\.", "할 수 없다."),
        (r"할 수 있습니다\.", "할 수 있다."),
