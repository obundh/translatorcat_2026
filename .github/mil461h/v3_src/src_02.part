PRESERVE_RE = re.compile(
    r"(?:https?://\S+|[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}|"
    r"MIL-STD-\d+[A-Z]?|SD-\d+|"
    r"(?:CE|CS|RE|RS)\d{3}(?:-\d+)?|"
    r"\b(?:AMSC|AREA|ASSIST|DoD|DOD|EMC|EME|EMI|EMICP|EMITP|EMITR|ERP|ESD|EUT|FCC|FFT|FWHM|GFE|IF|ISO|IEC|ANSI|IEEE|LISN|MAD|NDI|RF|RMS|TEM|TPD|CI|CW|DC|AC|NIST|DTRA|DISA|NSA|DID|DIDs|LRU|SRU)\b|"
    r"\b\d+(?:\.\d+)*(?:\([a-zA-Z0-9.]+\))*\b|"
    r"\b\d+(?:\.\d+)?\s*(?:Hz|kHz|MHz|GHz|dB|dBm|dBµA|dBpT|V/m|V|A|W|kW|m|cm|mm|ns|µs|μs|ms|µF|μF|ohm|Ω|%)\b)"
)

SECTION_RE = re.compile(r"^\s*(?:A\.)?\d+(?:\.\d+)*(?:\s*\([^)]*\))?\s+")
LIST_RE = re.compile(r"^\s*(?:[a-z]\.|\([a-z0-9]+\)|\d+\.|NOTE\s*:|NOTE\s+\d+\s*:)", re.I)
FORMULA_RE = re.compile(r"^[\s\dA-Za-z_+=×÷/\\|.,:;()\[\]{}<>^%µμΩ°#-]+$")
TOC_NUM_RE = re.compile(r"^\s*(?:(?:A\.)?\d+(?:\.\d+)*(?:\s*\([^)]*\))?|\d+\.|A\.\d+(?:\.\d+)*)\s*$")
DOTS_RE = re.compile(r"\.{5,}")
PAGE_END_RE = re.compile(r"\s+([ivxlcdmIVXLCDM]+|\d+)\s*$")


@dataclass
class Line:
    text: str
    bbox: tuple[float, float, float, float]
    font_size: float
    bold: bool
    italic: bool
    color: tuple[float, float, float]
    rotation: int
    block_no: int
    line_no: int


@dataclass
class Unit:
    text: str
    bbox: tuple[float, float, float, float]
    font_size: float
    bold: bool
    italic: bool
    color: tuple[float, float, float]
    rotation: int
    kind: str
    page_no: int


def pick_file(candidates: Sequence[str]) -> str:
    for p in candidates:
        if Path(p).exists():
            return p
    raise FileNotFoundError(f"No font found: {candidates}")


def rgb(value: int) -> tuple[float, float, float]:
    return (((value >> 16) & 255) / 255.0, ((value >> 8) & 255) / 255.0, (value & 255) / 255.0)


def norm(text: str) -> str:
    text = text.replace("\u00ad", "").replace("\ufeff", " ")
    text = re.sub(r"[ \t]+", " ", text)
    return text.strip()


def exact_lookup(text: str) -> str | None:
    t = norm(text)
    if t in EXACT:
        return EXACT[t]
    t2 = t.rstrip()
    if t2 in EXACT:
        return EXACT[t2]
    no_period = t.rstrip(".")
    if no_period in EXACT:
        v = EXACT[no_period]
        return v + ("." if t.endswith(".") and not v.endswith(".") else "")
    # Generic applicability / limits / procedures headings.
    m = re.fullmatch(r"((?:CE|CS|RE|RS)\d{3}) applicability\.?", t, re.I)
    if m:
        return f"{m.group(1).upper()} 적용성."
    m = re.fullmatch(r"((?:CE|CS|RE|RS)\d{3}) limits?\.?", t, re.I)
    if m:
        return f"{m.group(1).upper()} 한계값."
    m = re.fullmatch(r"((?:CE|CS|RE|RS)\d{3}) test procedures?\.?", t, re.I)
    if m:
        return f"{m.group(1).upper()} 시험 절차."
    return None

