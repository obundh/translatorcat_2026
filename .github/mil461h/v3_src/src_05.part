    if line.bbox[1] < 58 and (t == "MIL-STD-461H" or re.fullmatch(r"MIL-STD-461H\s*", t)):
        return True
    if line.bbox[1] > page.rect.height - 55:
        if re.fullmatch(r"[ivxlcdmIVXLCDM]+|\d+", t):
            return True
        if t.startswith("Downloaded from"):
            return True
    return False


def overlaps(rect: Sequence[float], other: Sequence[float], ratio: float = 0.35) -> bool:
    a, b = fitz.Rect(rect), fitz.Rect(other)
    inter = a & b
    if inter.is_empty:
        return False
    return (inter.width * inter.height) / max(1.0, a.width * a.height) >= ratio


def find_real_tables(page: fitz.Page) -> list:
    try:
        tables = list(page.find_tables().tables)
    except Exception:
        return []
    kept = []
    for table in tables:
        rows = len(table.rows)
        cols = max((len(row.cells) for row in table.rows), default=0)
        cells = rows * cols
        if rows < 2 or cols < 2 or cells < 4:
            continue
        extracted = table.extract()
        values = [norm(str(cell or "")) for row in extracted for cell in row]
        nonempty = [v for v in values if v]
        density = len(nonempty) / max(1, cells)
        avg_chars = sum(len(v) for v in nonempty) / max(1, len(nonempty))
        area = fitz.Rect(table.bbox).width * fitz.Rect(table.bbox).height
        if area < 800:
            continue
        # Graph grids and diagrams are sparse pseudo-tables.
        if density < 0.22:
            continue
        if cells >= 60 and avg_chars < 6.0:
            continue
        # Very large page-spanning grids are almost always figures.
        if cells >= 100 and area > page.rect.width * page.rect.height * 0.35:
            continue
        kept.append(table)
    return kept


def logical_units(page: fitz.Page, page_no: int, table_bboxes: list[Sequence[float]]) -> list[Unit]:
    lines = extract_lines(page)
    by_block: dict[int, list[Line]] = {}
    for line in lines:
        if is_header_footer(line, page):
            continue
        if any(overlaps(line.bbox, tb, 0.30) for tb in table_bboxes):
            continue
        by_block.setdefault(line.block_no, []).append(line)
    units: list[Unit] = []
    for block_lines in by_block.values():
        block_lines.sort(key=lambda x: (x.bbox[1], x.bbox[0]))
        block_width = max(x.bbox[2] for x in block_lines) - min(x.bbox[0] for x in block_lines)
        if block_width < 180 or any(x.rotation != 0 for x in block_lines):
            for line in block_lines:
                t = norm(line.text)
                if not t:
                    continue
                kind = "heading" if line.bold or SECTION_RE.match(t) else "label"
                units.append(Unit(t, line.bbox, line.font_size, line.bold, line.italic, line.color, line.rotation, kind, page_no))
            continue
        current: list[Line] = []
        current_kind = "paragraph"

        def flush() -> None:
            nonlocal current, current_kind
            if not current:
                return
            text = " ".join(norm(x.text) for x in current if norm(x.text)).strip()
            if text:
                bbox = (
                    min(x.bbox[0] for x in current), min(x.bbox[1] for x in current),
                    max(x.bbox[2] for x in current), max(x.bbox[3] for x in current),
                )
                units.append(Unit(
                    text=text,
                    bbox=bbox,
                    font_size=statistics.median(x.font_size for x in current),
                    bold=all(x.bold for x in current) if current_kind == "heading" else False,
                    italic=all(x.italic for x in current),
                    color=current[0].color,
                    rotation=current[0].rotation,
                    kind=current_kind,
                    page_no=page_no,
                ))
            current = []
            current_kind = "paragraph"

        prev: Line | None = None
        for line in block_lines:
            t = norm(line.text)
            if not t:
                flush()
                prev = line
                continue
            heading = bool(line.bold or SECTION_RE.match(t) or t in {"FOREWORD", "FIGURES", "TABLES"})
            list_item = bool(LIST_RE.match(t))
            gap = 0.0 if prev is None else line.bbox[1] - prev.bbox[3]
            if heading:
                continuation = bool(
                    current and current_kind == "heading"
                    and not SECTION_RE.match(t)
                    and not re.match(r"^(?:FIGURE|TABLE|NOTE)\b", t, re.I)
                )
                if continuation:
                    current.append(line)
                else:
                    flush()
                    current = [line]
                    current_kind = "heading"
            elif list_item:
                flush()
                current = [line]
                current_kind = "list"
            elif current and current_kind == "list" and (gap <= max(4.0, line.font_size * 0.45)):
                current.append(line)
            elif gap > max(5.0, line.font_size * 0.55):
                flush()
                current = [line]
                current_kind = "paragraph"
            else:
                if current_kind == "heading":
                    flush()
                current.append(line)
            prev = line
        flush()
    units.sort(key=lambda u: (u.bbox[1], u.bbox[0]))
    return units


def remove_text_and_artifacts(
    page: fitz.Page,
    lines: list[Line],
    keep_header_page: bool = True,
    force_redact_bboxes: list[Sequence[float]] | None = None,
) -> None:
    force_redact_bboxes = force_redact_bboxes or []
    # Capture source decorations before redaction. Blue filled bars are hyperlink
    # underlines; isolated left-margin vertical strokes are source link artifacts.
    artifact_rects: list[fitz.Rect] = []
    for drawing in page.get_drawings():
        rect = fitz.Rect(drawing["rect"])
        color = drawing.get("color")
        fill = drawing.get("fill")
        blue = bool((color and color[2] > 0.65 and color[0] < 0.35) or (fill and fill[2] > 0.65 and fill[0] < 0.35))
        isolated_left_vertical = bool(
            len(drawing.get("items", [])) == 1 and rect.x0 < 70 and rect.width < 2.5 and rect.height > 25
        )
        if blue or isolated_left_vertical:
            artifact_rects.append(rect)
    for link in list(page.get_links()):
        try:
            page.delete_link(link)
        except Exception:
            pass
    annot = page.first_annot
    while annot:
