{
  "name": "translatorcat-2026",
  "version": "0.1.0",
  "description": "A tiny desktop cat that shows clipboard text in a speech bubble.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --dir"
  },
  "keywords": [
    "desktop-pet",
    "clipboard",
    "cat",
    "electron"
  ],
  "author": "obundh",
  "license": "MIT",
  "devDependencies": {
    "electron": "42.3.2",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.obundh.translatorcat2026",
    "productName": "TranslatorCat",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "electron/**/*",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/TranslatorCat-MIT-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "DEPENDENCY_SOURCES.md",
        "to": "licenses/DEPENDENCY_SOURCES.md"
      },
      {
        "from": "licenses/onnxruntime-MIT.txt",
        "to": "licenses/onnxruntime-MIT.txt"
      },
      {
        "from": "node_modules/electron/LICENSE",
        "to": "licenses/Electron-MIT.txt"
      },
      {
        "from": "node_modules/@huggingface/transformers/LICENSE",
        "to": "licenses/Transformers.js-Apache-2.0.txt"
      },
      {
        "from": "node_modules/sharp/LICENSE",
        "to": "licenses/sharp-Apache-2.0.txt"
      },
      {
        "from": "node_modules/@img/sharp-win32-x64/LICENSE",
        "to": "licenses/sharp-win32-x64-Apache-2.0-and-LGPL-3.0-or-later.txt"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "TranslatorCat-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
