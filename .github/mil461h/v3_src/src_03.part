    "measurement tolerances": "측정 허용오차",
    "full width half maximum": "반치전폭",
    "root mean square": "실효값",
    "fast Fourier transform": "고속 푸리에 변환",
    "effective radiated power": "유효 방사전력",
    "electrostatic discharge": "정전기 방전",
    "line impedance stabilization network": "선로 임피던스 안정화 회로망",
    "transient protection device": "과도 보호소자",
    "common mode": "공통모드",
    "bulk cable injection": "케이블 다발 주입",
}

PRESERVE_RE = re.compile(
    r"(?:https?://\S+|[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}|"
    r"MIL-STD-\d+[A-Z]?|SD-\d+|"
    r"(?:CE|CS|RE|RS)\d{3}(?:-\d+)?|"
    r"\b(?:AMSC|AREA|ASSIST|DoD|DOD|EMC|EME|EMI|EMICP|EMITP|EMITR|ERP|ESD|EUT|FCC|FFT|FWHM|GFE|IF|ISO|IEC|ANSI|IEEE|LISN|MAD|NDI|RF|RMS|TEM|TPD|CI|CW|DC|AC|NIST|DTRA|DISA|NSA|DID|DIDs|LRU|SRU)\b|"
    r"\b\d+(?:\.\d+)*(?:\([a-zA-Z0-9.]+\))*\b|"
    r"\b\d+(?:\.\d+)?\s*(?:Hz|kHz|MHz|GHz|dB|dBm|dBµA|dBpT|V/m|V|A|W|kW|m|cm|mm|ns|µs|μs|ms|µF|μF|ohm|Ω|%)\b)"
)

SECTION_RE = re.compile(r"^\s*(?:A\.)?\d+(?:\.\d+)*(?:\s*\([^)]*\))?\s+")
LIST_RE = re.compile(r"^\s*(?:[a-z]\.|\([a-z0-9]+\)|\d+\.|NOTE\s*:|NOTE\s+\d+\s*:)", re.I)
FORMULA_RE = re.compile(r"^[\s\dA-Za-z_+=×÷/\\|.,:;()\[\]{}<>^%µμΩ°#-]+$")
TOC_NUM_RE = re.compile(r"^\s*(?:(?:A\.)?\d+(?:\.\d+)*(?:\s*\([^)]*\))?|\d+\.|A\.\d+(?:\.\d+)*)\s*$")
DOTS_RE = re.compile(r"\.{5,}")
PAGE_END_RE = re.compile(r"([ivxlcdmIVXLCDM]+|\d+)\s*$")


@dataclass
class Line:
    text: str
    bbox: tuple[float, float, float, float]
    font_size: float
    bold: bool
    italic: bool
    color: tuple[float, float, float]
    rotation: int
    block_no: int
    line_no: int


@dataclass
class Unit:
    text: str
    bbox: tuple[float, float, float, float]
    font_size: float
    bold: bool
    italic: bool
    color: tuple[float, float, float]
    rotation: int
    kind: str
    page_no: int


def pick_file(candidates: Sequence[str]) -> str:
    for p in candidates:
        if Path(p).exists():
            return p
    raise FileNotFoundError(f"No font found: {candidates}")


def rgb(value: int) -> tuple[float, float, float]:
    return (((value >> 16) & 255) / 255.0, ((value >> 8) & 255) / 255.0, (value & 255) / 255.0)


def norm(text: str) -> str:
    text = text.replace("\u00ad", "").replace("\ufeff", " ")
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def exact_lookup(text: str) -> str | None:
    t = norm(text)
    if t in EXACT:
        return EXACT[t]
    t2 = t.rstrip()
    if t2 in EXACT:
        return EXACT[t2]
    no_period = t.rstrip(".")
    if no_period in EXACT:
        v = EXACT[no_period]
        return v + ("." if t.endswith(".") and not v.endswith(".") else "")
    if not t.endswith(".") and f"{t}." in EXACT:
        return EXACT[f"{t}."]
    bullet = re.match(r"^(\*{1,2}\s+)(.+)$", t)
    if bullet:
        translated = exact_lookup(bullet.group(2))
        if translated is not None:
            return bullet.group(1) + translated
    # Preserve section designators while translating their heading text.
    m = re.match(r"^((?:A\.)?\d+(?:\.\d+)*(?:\s*\([^)]*\))?)\s+(.+)$", t)
    if m:
        number, title = m.groups()
        translated_title = exact_lookup(title)
        if translated_title is not None:
            return f"{number} {translated_title}"
    # Generic applicability / limits / procedures headings.
    m = re.fullmatch(r"((?:CE|CS|RE|RS)\d{3}) applicability\.?", t, re.I)
    if m:
        return f"{m.group(1).upper()} 적용성."
    m = re.fullmatch(r"((?:CE|CS|RE|RS)\d{3}) limits?\.?", t, re.I)
    if m:
        return f"{m.group(1).upper()} 한계값."
    m = re.fullmatch(r"((?:CE|CS|RE|RS)\d{3}) test procedures?\.?", t, re.I)
    if m:
        return f"{m.group(1).upper()} 시험 절차."
    return None


def should_translate(text: str) -> bool:
    t = norm(text)
    if not t or not re.search(r"[A-Za-z]{2,}", t):
        return False
    if re.fullmatch(r"(?:MIL-STD-\d+[A-Z]?|(?:CE|CS|RE|RS)\d{3}(?:-\d+)?|[A-Z0-9/._-]{2,})", t):
        return False
    if FORMULA_RE.fullmatch(t) and not re.search(r"[A-Za-z]{4,}\s+[A-Za-z]{3,}", t):
        return False
    return True


def protect(text: str) -> tuple[str, dict[str, str]]:
    # Insert approved Korean terminology directly. Google reliably preserves Korean
    # inside an English sentence, while numbered placeholder tokens may be reordered.
    work = text
    for phrase, korean in sorted(TERM_MAP.items(), key=lambda x: len(x[0]), reverse=True):
        work = re.sub(re.escape(phrase), korean, work, flags=re.I)
    # URLs are the only items that need opaque protection.
    mapping: dict[str, str] = {}
    def repl_url(m: re.Match[str]) -> str:
        key = f"ZXQURL{len(mapping):04d}QXZ"
        mapping[key] = m.group(0)
        return key
    work = re.sub(r"https?://\S+", repl_url, work)
    return work, mapping


def restore(text: str, mapping: dict[str, str]) -> str:
    out = re.sub(
        r"Z\s*X\s*Q\s*(?:P\s*H|U\s*R\s*L)\s*(\d+)\s*Q\s*X\s*Z",
        lambda m: f"ZXQURL{int(m.group(1)):04d}QXZ",
        text,
        flags=re.I,
    )
    for key, value in mapping.items():
        out = out.replace(key, value)
    return out


