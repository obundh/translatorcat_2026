        nxt = annot.next
        try:
            page.delete_annot(annot)
        except Exception:
            pass
        annot = nxt
    for line in lines:
        t = norm(line.text)
        if not t:
            continue
        footer = t.startswith("Downloaded from")
        forced = any(overlaps(line.bbox, tb, 0.20) for tb in force_redact_bboxes)
        if keep_header_page and is_header_footer(line, page) and not footer:
            continue
        if not (footer or forced or should_translate(t) or exact_lookup(t) is not None):
            # Keep numerical ticks, formulas, units and test codes in their exact source positions.
            continue
        page.add_redact_annot(fitz.Rect(line.bbox), fill=None, cross_out=False)
    page.apply_redactions(
        images=fitz.PDF_REDACT_IMAGE_NONE,
        graphics=fitz.PDF_REDACT_LINE_ART_NONE,
        text=fitz.PDF_REDACT_TEXT_REMOVE,
    )
    for rect in artifact_rects:
        cover = fitz.Rect(rect.x0 - 1.0, rect.y0 - 1.0, rect.x1 + 1.0, rect.y1 + 1.0)
        page.draw_rect(cover, color=None, fill=(1, 1, 1), overlay=True)


def font_size_for(unit: Unit) -> tuple[float, float, float]:
    if unit.kind == "heading":
        return min(10.2, max(8.6, unit.font_size * 0.92)), 7.8, 1.08
    if unit.kind == "list":
        return min(9.2, max(8.1, unit.font_size * 0.84)), 7.1, 1.12
    if unit.kind == "label":
        return min(8.6, max(6.6, unit.font_size * 0.82)), 5.2, 1.05
    return min(9.3, max(8.2, unit.font_size * 0.84)), 7.2, 1.12


def place_text_fit(page: fitz.Page, unit: Unit, text: str, regular_font: str, bold_font: str, next_y: float | None = None) -> dict:
    rect = fitz.Rect(unit.bbox)
    if unit.rotation == 0:
        rect.x1 = min(page.rect.width - 42, max(rect.x1 + 2.0, 540 if rect.x0 < 100 else rect.x1 + 2.0))
        if next_y is not None and next_y > rect.y1:
            rect.y1 = max(rect.y1 + 0.8, min(next_y - 1.5, rect.y1 + max(4.0, unit.font_size * 0.9)))
        else:
            rect.y1 += max(1.0, unit.font_size * 0.18)
    else:
        rect.x0 -= 0.5; rect.x1 += 0.5; rect.y0 -= 0.5; rect.y1 += 0.5
    fontfile = bold_font if unit.bold or unit.kind == "heading" else regular_font
    start, minimum, lineheight = font_size_for(unit)
    color = unit.color
    # Hyperlink blue is not retained; body is rendered in clean black.
    if color[2] > 0.5 and color[0] < 0.4:
        color = (0.0, 0.0, 0.0)
    size = start
    spare = -1.0
    while size >= minimum - 0.01:
        shape = page.new_shape()
        spare = shape.insert_textbox(
            rect, text, fontfile=fontfile, fontname="fit", fontsize=size,
            lineheight=lineheight, color=color, align=0, rotate=unit.rotation,
        )
        if spare >= -0.05:
            break
        size -= 0.2
    overflow = spare < -0.05
    if overflow and unit.rotation == 0:
        # One final expansion into unused local space, never past the page footer.
        rect.y1 = min(page.rect.height - 48, rect.y1 + max(5.0, unit.font_size * 1.2))
        size = minimum
        lineheight = 1.05
        shape = page.new_shape()
        spare = shape.insert_textbox(rect, text, fontfile=fontfile, fontname="fit2", fontsize=size, lineheight=lineheight, color=color, align=0)
        overflow = spare < -0.05
    page.insert_textbox(
        rect, text, fontfile=fontfile,
        fontname="kobold" if fontfile == bold_font else "koreg",
        fontsize=size, lineheight=lineheight, color=color, align=0,
        rotate=unit.rotation, overlay=True,
    )
    return {"page": unit.page_no, "kind": unit.kind, "source": unit.text[:250], "translation": text[:250], "bbox": list(rect), "font_original": unit.font_size, "font_used": size, "overflow": overflow}


def cell_font_size(source_size: float, cell: fitz.Rect, text: str) -> tuple[float, float]:
    if cell.width < 45:
        return min(6.3, max(5.4, source_size * 0.80)), 4.8
    if cell.width < 90:
        return min(7.4, max(6.2, source_size * 0.82)), 5.3
    return min(8.8, max(7.0, source_size * 0.84)), 5.8


def source_cell_style(page: fitz.Page, cell: fitz.Rect) -> tuple[float, bool, int]:
    sizes = []
    bolds = []
    centers = []
    data = page.get_text("dict", flags=fitz.TEXTFLAGS_DICT)
    for block in data.get("blocks", []):
        if block.get("type") != 0:
            continue
        for line in block.get("lines", []):
            for span in line.get("spans", []):
                sb = fitz.Rect(span["bbox"])
                center = ((sb.x0 + sb.x1) / 2, (sb.y0 + sb.y1) / 2)
                if cell.contains(center) and span.get("text", "").strip():
                    sizes.append(float(span.get("size", 8)))
                    bolds.append("bold" in span.get("font", "").lower() or (int(span.get("flags", 0)) & 16))
                    centers.append((sb.x0 + sb.x1) / 2)
    size = statistics.median(sizes) if sizes else 8.0
    bold = sum(1 for x in bolds if x) >= max(1, len(bolds) // 2) if bolds else False
    align = 1 if centers and abs(statistics.median(centers) - (cell.x0 + cell.x1) / 2) < cell.width * 0.12 else 0
    return size, bold, align


def place_table_cell(page: fitz.Page, source_page: fitz.Page, cell_bbox: Sequence[float], text: str, regular_font: str, bold_font: str, header: bool) -> dict:
    cell = fitz.Rect(cell_bbox)
    src_size, src_bold, align = source_cell_style(source_page, cell)
    bold = header or src_bold
    fontfile = bold_font if bold else regular_font
    rect = fitz.Rect(cell.x0 + 4.0, cell.y0 + 1.5, cell.x1 - 4.0, cell.y1 - 1.5)
    start, minimum = cell_font_size(src_size, cell, text)
    if "\n" not in text and cell.height < 14:
        font = fitz.Font(fontfile=fontfile)
        size = min(start, 5.8)
        while font.text_length(text, fontsize=size) > rect.width and size > 4.6:
            size -= 0.15
        tw = font.text_length(text, fontsize=size)
        x = rect.x0 + max(0, (rect.width - tw) / 2)
        y = cell.y0 + (cell.height + size) / 2 - 1.0
        page.insert_text((x, y), text, fontfile=fontfile, fontname="tshort", fontsize=size, color=(0,0,0), overlay=True)
        return {"bbox": list(cell), "text": text, "font_used": size, "overflow": tw > rect.width + 0.2}
    size = start
    spare = -1.0
    while size >= minimum - 0.01:
        shape = page.new_shape()
        spare = shape.insert_textbox(rect, text, fontfile=fontfile, fontname="tfit", fontsize=size, lineheight=1.08, color=(0,0,0), align=align)
        if spare >= -0.05:
            break
        size -= 0.15
    overflow = spare < -0.05
    if overflow:
